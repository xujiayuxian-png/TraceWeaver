{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "web_l4l7_failures diagnosis",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "One-sentence verdict in plain English."
    },
    "failure_layer": {
      "type": "string",
      "enum": ["dns", "tcp", "tls", "websocket", "http", "none"],
      "description": "Which protocol layer the primary failure occurred at."
    },
    "root_cause": {
      "type": "string",
      "description": "Operator-actionable description of what broke and why."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {"type": "integer"},
          "event": {"type": "string"},
          "note": {"type": "string"}
        },
        "required": ["seq", "event"]
      },
      "description": "Frames that justify the diagnosis."
    },
    "remediation": {
      "type": "string",
      "description": "What the operator should do to fix or work around the failure."
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  },
  "required": ["summary", "failure_layer", "root_cause", "evidence", "confidence"]
}
