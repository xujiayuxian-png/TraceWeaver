{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open5GS 5GC diagnosis result",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "evidence", "confidence"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["success", "failure", "unclear"]
    },
    "summary": {"type": "string"},
    "failure_point": {"type": ["string", "null"]},
    "root_cause": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "event"],
        "properties": {
          "seq": {"type": "integer"},
          "event": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
